#!/bin/sh

# INIT
printf "$$" > ~/.cache/pidofbar
sec=0

# MODULES
update_memory () { 
	memory="$(free -h | sed -n "2s/\([^ ]* *\)\{2\}\([^ ]*\).*/\2/p")"
}

update_cpu () { 
    	read cpu a b c previdle rest < /proc/stat
	prevtotal=$((a+b+c+previdle))
	sleep 0.5
	read cpu a b c idle rest < /proc/stat
	total=$((a+b+c+idle))
	cpu=$((100*( (total-prevtotal) - (idle-previdle) ) / (total-prevtotal) ))
    	cpu_value=$(grep -o "^[^ ]*" /proc/loadavg)
	cpu="$cpu%"
}

update_cputemp () { 
	cputemp="$(head -c 2 /sys/class/thermal/thermal_zone0/temp)°C"
}

update_bat () { 
	read -r bat_status </sys/class/power_supply/BAT0/status
	read -r bat_capacity </sys/class/power_supply/BAT0/capacity
	if [ "$bat_status" = "Charging" ]; then
		bat_status=""
	elif [ "$bat_status" = "Full" ]; then
		bat_status="🔋" && notify-send '🔋⚡ Battery charged!!!' 'Unplug the laptop!!!'		
	elif [ "$bat_capacity" -gt 80 ]; then
		bat_status=""
	elif [ "$bat_capacity" -gt 60 ]; then
		bat_status=""
	elif [ "$bat_capacity" -gt 40 ]; then
		bat_status=""
	elif [ "$bat_capacity" -gt 30 ]; then
		bat_status=""
	elif [ "$bat_capacity" -gt 20 ]; then
		bat_status=""				
	elif [ "$bat_capacity" -gt 0 ]; then
		bat_status="🪫" && notify-send -u critical '🪫❗❗❗ Battery low!!!' 'Plug in the adapter!!!'
	else 
		bat_status=""
	fi
	bat="$bat_status$bat_capacity%"
}

update_wifi () {
#	wifi="$(grep -qw up /sys/class/net/wl*/operstate && echo "" || echo "")"
	wifi="$([ $(cat /sys/class/net/wl*/operstate) = down ] && echo '' || echo '')"
}

update_time () { 
	time="$(date "+%a %d.%m.%Y %R")"
}

# modules that don't update on their own, need to be run at the start for getting their initial value
update_keyboard () { 
	layout="$(setxkbmap -query | sed -n 's/layout:\s\+\(.*\)/\1/p')"
}
update_keyboard

update_vol () { 
	vol="$([ $(amixer -D pulse get Master | grep Left: | sed 's/[][]//g' | awk '{print $6}') = off ] && echo '🔇' || echo $(amixer -D pulse get Master | grep Left: | sed 's/[][]//g' | awk '{print $5}'))"
}
update_vol

update_backlight () { 
	read -r actual_brightness </sys/class/backlight/intel_backlight/actual_brightness
	read -r max_brightness </sys/class/backlight/intel_backlight/max_brightness
	backlight="$((actual_brightness*100/max_brightness))%"
}
update_backlight

display () { 
	xsetroot -name "$memory  $cpu $cputemp  $bat  $backlight  $vol  $wifi  $layout  $time"
}

# signals for each module to update while updating display. RTMIN is 34
trap "update_vol;display" "RTMIN"
trap "update_backlight;display" "RTMIN+1"
trap "update_keyboard;display" "RTMIN+2"

while true
do
	sleep 1 &
  wait && {
		# how many seconds each module updates
		[ $((sec % 7)) -eq 0 ] && update_memory
		[ $((sec % 8)) -eq 0 ] && update_cpu
		[ $((sec % 9)) -eq 0 ] && update_cputemp
		[ $((sec % 10 )) -eq 0 ] && update_bat
		[ $((sec % 12 )) -eq 0 ] && update_wifi
		[ $((sec % 60 )) -eq 0 ] && update_time

		# how often the display updates ( 5 seconds )
		[ $((sec % 5 )) -eq 0 ] && display
		sec=$((sec + 1))
	}
done
